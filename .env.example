# Copy these into Vercel → Project Settings → Environment Variables
# (and into a local .env for `bun run dev`).

# --- Backend (Supabase) ---
# Browser-visible (safe to expose, protected by Row Level Security)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side equivalents (used during SSR / server routes)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Optional: only needed for privileged server-side operations
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# --- Payments (Razorpay) --- server-only, never prefix with VITE_
RAZORPAY_KEY_ID="rzp_test_xxx"
RAZORPAY_KEY_SECRET="xxx"
