# Copy these into Vercel → Project Settings → Environment Variables
# (and into a local .env for `bun run dev`).
#
# Anything prefixed with VITE_ is baked into the browser bundle at BUILD time,
# so it must be present in Vercel before the build runs. Everything else is
# read at runtime by SSR / server functions.

# --- Public site URL (canonical links, Open Graph, sitemap, robots.txt) ---
VITE_SITE_URL="https://your-app.vercel.app"

# --- Backend (Supabase) ---
# Browser-visible (safe to expose, protected by Row Level Security)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side equivalents (used during SSR / server functions)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Privileged server-only key. Required for: payment webhook settlement,
# expiring stale checkout holds, and account deletion.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# --- Payments (Razorpay) ---
# Browser key. Test builds use rzp_test_..., production uses rzp_live_...
# Already committed in .env.development / .env.production.
VITE_RAZORPAY_KEY_ID="rzp_test_xxx"

# Server-only. From Razorpay Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_SECRET="xxx"

# Server-only. From Razorpay Dashboard -> Settings -> Webhooks. Point the
# webhook at https://<your-domain>/api/public/payments/razorpay-webhook and
# subscribe to payment.captured, payment.failed, refund.processed and the
# subscription.* events.
RAZORPAY_WEBHOOK_SECRET="xxx"
