# Copy these into Vercel → Project Settings → Environment Variables
# (and into a local .env for `bun run dev`).
#
# Anything prefixed with VITE_ is baked into the browser bundle at BUILD time,
# so it must be present in Vercel before the build runs. Everything else is
# read at runtime by SSR / server functions.

# --- Public site URL (canonical links, Open Graph, sitemap, robots.txt) ---
VITE_SITE_URL="https://your-app.vercel.app"

# --- Backend (Supabase) ---
# Browser-visible (safe to expose, protected by Row Level Security)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side equivalents (used during SSR / server functions)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Privileged server-only key. Required for: payment webhook settlement,
# expiring stale checkout holds, and account deletion.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# --- Payments (Paddle) ---
# Browser token. Test builds use test_..., production builds use live_...
# Already committed in .env.development / .env.production; override here to
# point a Vercel deployment at a different Paddle account.
VITE_PAYMENTS_CLIENT_TOKEN="live_xxx"

# Server-only. Used to call Paddle through the payment gateway.
PADDLE_SANDBOX_API_KEY="xxx"
PADDLE_LIVE_API_KEY="xxx"
PAYMENTS_SANDBOX_WEBHOOK_SECRET="pdl_ntfset_xxx"
PAYMENTS_LIVE_WEBHOOK_SECRET="pdl_ntfset_xxx"
LOVABLE_API_KEY="xxx"
